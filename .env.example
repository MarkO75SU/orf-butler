# Admin login for the website login page (required for password login).
# Set these as Environment Variables in the Vercel project (Production) as well.
LOGIN_USER=your-admin-username
LOGIN_PASS=your-admin-password

# Optional: social login (Google / Apple / GitHub) via Supabase.
# If left empty, the social buttons report "Social login is not available."
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
