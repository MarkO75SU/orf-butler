{
  "buildCommand": "echo 'Static build'",
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/landing", "destination": "/landing.html" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/scripts/(.*)", "destination": "/scripts/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/lib/(.*)", "destination": "/404", "permanent": false },
    { "source": "/src/tests/(.*)", "destination": "/404", "permanent": false }
  ]
}
