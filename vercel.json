{
  "buildCommand": "echo 'Static build'",
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/landing", "destination": "/landing.html" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
