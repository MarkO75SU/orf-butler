{
  "buildCommand": "echo 'Static build'",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    { "source": "/landing", "destination": "/landing.html" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/lib/(.*)", "destination": "/404", "permanent": false },
    { "source": "/tests/(.*)", "destination": "/404", "permanent": false }
  ]
}
